# Copie este arquivo para .env e cole o valor real:
#   cp .env.example .env
#
# CONTAINER_CONFIG vem do GTM:
#   Tag Manager > container Servidor > clique no ID do container (canto sup. direito)
#   > "Provisionar servidor de tags manualmente" > copie o valor de "Container Config"
CONTAINER_CONFIG=cole_aqui_a_string_do_gtm

# PREVIEW_SERVER_URL: URL HTTPS publica do preview server (porta 8081).
# Necessaria APENAS para usar o modo Preview do GTM (ver secao cloudflared no README).
# Deve ser HTTPS — uma URL HTTP local e rejeitada pelo tagging server.
# Deixe vazio se nao for usar o preview; o tagging server sobe mesmo assim.
PREVIEW_SERVER_URL=
